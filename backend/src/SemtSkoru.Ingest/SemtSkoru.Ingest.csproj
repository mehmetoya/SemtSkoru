<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone runner for the İBB ingestion jobs, for a machine in Turkey (İBB only accepts
       Turkish IPs - see IbbIngestionJobCatalog). Deliberately no Hangfire and no web host: it
       runs the same job classes as the API, once, then exits. See docs/deployment.md. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SemtSkoru.Infrastructure\SemtSkoru.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
